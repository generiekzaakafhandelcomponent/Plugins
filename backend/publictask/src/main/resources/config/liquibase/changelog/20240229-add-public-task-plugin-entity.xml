<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet id="1" author="Ritense">
        <createTable tableName="public_task_plugin_entity">
            <column name="public_task_id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_task_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="process_business_key" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="assignee_candidate_contact_data" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="task_expiration_date" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="is_completed_by_public_task" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="Ritense">
        <modifyDataType tableName="public_task_plugin_entity"
                        columnName="process_business_key"
                        newDataType="VARCHAR(255)"/>
    </changeSet>

    <!-- Bounds what the unauthenticated upload endpoint can add, across restarts and instances. -->
    <changeSet id="3" author="Ritense">
        <addColumn tableName="public_task_plugin_entity">
            <column name="attachment_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- What this task's upload endpoint accepts. Older tasks get the plugin's own defaults. -->
    <changeSet id="4" author="Ritense">
        <addColumn tableName="public_task_plugin_entity">
            <column name="max_attachments" type="INT" defaultValueNumeric="10">
                <constraints nullable="false"/>
            </column>
            <column name="max_attachment_size_in_bytes" type="BIGINT" defaultValueNumeric="10485760">
                <constraints nullable="false"/>
            </column>
            <column name="accepted_mime_types" type="VARCHAR(1024)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- The metadata every file uploaded through this task is filed with, as JSON. Older tasks carry none. -->
    <changeSet id="5" author="Ritense">
        <addColumn tableName="public_task_plugin_entity">
            <column name="document_metadata" type="VARCHAR(4096)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- The address the link of this task was built with. Older tasks fall back to the application setting. -->
    <changeSet id="6" author="Ritense">
        <addColumn tableName="public_task_plugin_entity">
            <column name="base_url" type="VARCHAR(512)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
