<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="create_table_xential_tokens_4" author="Ritense">
        <createTable tableName="xential_tokens">
            <column name="token" type="uuid"/>
            <column name="process_id" type="uuid"/>
            <column name="message_name" type="VARCHAR(256)"/>
            <column name="resume_url" type="VARCHAR(2083)"/>
        </createTable>
    </changeSet>

    <changeSet id="add_expires_on_to_xential_tokens" author="Ritense">
        <addColumn tableName="xential_tokens">
            <column name="expires_on" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!--
      ~ Records which Xential plugin configuration started the document creation session, so that its callback is
      ~ verified against that configuration's callbackSecret instead of an arbitrarily chosen one.
      ~
      ~ Nullable on purpose: sessions that already existed when this column was added have no value, and those
      ~ sessions must keep loading after the upgrade.
      -->
    <changeSet id="add_plugin_configuration_id_to_xential_tokens" author="Ritense">
        <addColumn tableName="xential_tokens">
            <column name="plugin_configuration_id" type="uuid">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
